{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y krds-a11y-mcp stop-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y krds-a11y-mcp pretool-hook"
          }
        ]
      }
    ]
  }
}
